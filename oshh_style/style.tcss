Screen {
  background: $background;
  color: $foreground;
}

#header {
  height: 1;
  background: $primary;
  color: $background;
}

#body {
  height: 1fr;
}

#nav {
  width: 34;
  height: 1fr;
  background: $background;
  border: round $panel;
  padding: 0 1;
  scrollbar-size-vertical: 1;
}

#nav:focus {
  border: round $primary;
}

#main {
  width: 1fr;
  height: 1fr;
  border: round $panel;
  padding: 0 1;
}

#main:focus-within {
  border: round $primary;
}

#crumbs {
  height: 2;
  color: $primary;
}

#page {
  height: 1fr;
}

#help {
  height: 2;
  padding-top: 1;
  color: $text-muted;
}

.page {
  height: 1fr;
}

Row:focus {
  background: $primary 22%;
}

Row:hover {
  background: $panel;
}

#list {
  width: 40%;
  min-width: 30;
  height: 1fr;
  background: $background;
  border: none;
  margin-right: 2;
  scrollbar-size-vertical: 1;
}

#side {
  width: 1fr;
  height: 1fr;
}

#palette {
  height: 1;
  margin-top: 1;
}

#info {
  height: auto;
  margin-top: 1;
}

.dim {
  color: $text-muted;
  margin-top: 1;
}

#raw-filter {
  height: 3;
  margin-bottom: 1;
}

#raw-rows {
  height: 1fr;
}

ScenePage SettingsPage, ScenePage RawList {
  width: 45%;
  min-width: 44;
  margin-right: 2;
}

#option-info {
  height: auto;
}

#try-keys {
  margin-top: 1;
}

#try-scroll, #file-view {
  height: 1fr;
  margin-top: 1;
  border: round $panel;
  padding: 0 1;
}

TextModal {
  align: center middle;
}

ChoiceModal {
  align: left middle;
  background: transparent;
}

ChoiceModal #modal {
  width: 56;
  margin-left: 2;
}

#modal {
  width: 64;
  height: auto;
  max-height: 80%;
  background: $surface;
  border: round $primary;
  padding: 1 2;
}

.modal-title {
  text-style: bold;
  margin-bottom: 1;
}

#modal-list {
  height: 20;
  background: $surface;
  border: none;
}

KeepModal {
  align: center middle;
}
